{
	"name": "stepstr",
	"private": true,
	"version": "0.0.1",
	"description": "Opens any STEP file in the browser, with section cuts, part visibility, exploded views, exact measurements and share links.",
	"homepage": "https://stepstr.space",
	"repository": "github:Gangleri42/stepstr",
	"license": "Unlicense",
	"type": "module",
	"engines": {
		"node": "^22.12.0 || ^24.0.0 || >=26.0.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.node.json && tsc -p tsconfig.worker.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"build:napplet": "vite build --config vite.napplet.config.ts && tsx pipeline/napplet-manifest.ts",
		"dev:napplet": "vite --config vite.napplet.config.ts --host 127.0.0.1 --port 5174",
		"paja": "kehto paja --target-url http://127.0.0.1:5174 -- npm run dev:napplet",
		"dev:shell": "node scripts/dev-shell/serve.mjs",
		"test:conformance": "napplet-conformance ./dist-napplet",
		"test:e2e": "playwright test",
		"fixtures": "node scripts/fixtures.mjs",
		"oracle": "node scripts/oracle.mjs",
		"publish:nostr": "tsx pipeline/publish-nostr.ts",
		"verify:nostr": "tsx pipeline/verify-nostr.ts"
	},
	"devDependencies": {
		"@kehto/cli": "^0.5.0",
		"@kehto/shell": "^0.21.2",
		"@napplet/conformance-cli": "^0.2.19",
		"@napplet/vite-plugin": "^0.14.1",
		"@playwright/test": "1.63.0",
		"@scure/base": "^2.0.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^26.6.3",
		"@types/three": "^0.186.0",
		"@types/ws": "^8.18.1",
		"fake-indexeddb": "^6.2.5",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^5.0.2",
		"ws": "^8.22.0"
	},
	"dependencies": {
		"@gltf-transform/core": "^4.5.0",
		"@noble/hashes": "^2.4.0",
		"fflate": "^0.8.3",
		"meshoptimizer": "^1.3.0",
		"nostr-tools": "^2.25.2",
		"three": "^0.186.1",
		"three-mesh-bvh": "^0.9.15"
	}
}
